---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/Card.astro";
import PageContainer from "../../components/PageContainer.astro";
import basesData from "../../data/bases.json";
import type { BaseRecord } from "../../types/base";

const bases = basesData as BaseRecord[];

const relatedPages = [
  {
    title: "Interactive Map",
    description: "Use the map hub to plan routes between locations and future base candidates.",
    href: "/maps/interactive-map",
  },
  {
    title: "Map Difficulty Ranking",
    description: "Compare major map areas before choosing where to start or relocate.",
    href: "/maps/difficulty-ranking",
  },
  {
    title: "Locations Database",
    description: "Browse all tracked Project Zomboid locations from one database entry point.",
    href: "/locations",
  },
];
---

<BaseLayout
  title="Best Base Locations in Project Zomboid"
  description="Compare Project Zomboid base locations by safety, resources, difficulty and recommended play style."
  ogType="article"
>
  <PageContainer as="section" class="py-12 sm:py-16">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold text-zsd-orange">Base Location Database</p>
      <h1 class="mt-3 text-4xl font-bold text-zsd-ash">Best Base Locations in Project Zomboid</h1>
      <p class="mt-5 text-base leading-7 text-zsd-muted">
        Choosing a base is one of the most important survival decisions in Project Zomboid. A strong
        base gives you safer storage, better recovery time and a clearer plan for future supply runs.
      </p>
    </div>

    <section class="mt-12" aria-labelledby="base-ranking-title">
      <div class="mb-6 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="text-sm font-semibold text-zsd-orange">Base Ranking Cards</p>
          <h2 id="base-ranking-title" class="mt-2 text-2xl font-semibold text-zsd-ash">
            First base comparison set
          </h2>
        </div>
        <p class="max-w-xl text-sm leading-6 text-zsd-muted">
          MVP v0.1 starts with a small set of practical base candidates. More bases can be added later
          by editing the data file.
        </p>
      </div>

      <div class="grid gap-4 lg:grid-cols-2">
        {
          bases.map((base) => (
            <Card
              title={base.name}
              description={base.description}
              href={base.guideLink}
              label="View Location Guide"
              eyebrow="Base Name"
              badge={base.difficulty}
              stats={[
                { label: "Location", value: base.location },
                { label: "Safety", value: base.safety },
                { label: "Resources", value: base.resources },
                { label: "Recommended Player", value: base.recommendedFor },
              ]}
            />
          ))
        }
      </div>
    </section>

    <section class="mt-12" aria-labelledby="related-title">
      <div class="mb-6">
        <p class="text-sm font-semibold text-zsd-orange">Related Pages</p>
        <h2 id="related-title" class="mt-2 text-2xl font-semibold text-zsd-ash">Continue planning</h2>
      </div>

      <div class="grid gap-4 md:grid-cols-3">
        {relatedPages.map((page) => <Card {...page} label="Open page" />)}
      </div>
    </section>
  </PageContainer>
</BaseLayout>
