---
import Card from "../../components/Card.astro";
import PageContainer from "../../components/PageContainer.astro";
import StatsTable from "../../components/StatsTable.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const locationStats = [
  { label: "Area", value: "Louisville" },
  { label: "Location Type", value: "Military loot objective" },
  { label: "Difficulty", value: "Hard" },
  { label: "Recommended For", value: "Veteran Players" },
  { label: "Loot Focus", value: "Weapons and equipment" },
  { label: "Risk Level", value: "High" },
];

const overviewCards = [
  {
    title: "High-Value Loot Target",
    description:
      "This page treats the Louisville military base search intent as a high-risk military loot objective for prepared runs.",
  },
  {
    title: "Advanced Route Planning",
    description:
      "The area should be approached only after transport, escape paths and recovery supplies are already planned.",
  },
  {
    title: "Not a First Base Pick",
    description:
      "Its value comes from targeted loot access, not from being the safest place to establish a first long-term base.",
  },
];

const militaryLootNotes = [
  "Use military loot runs to fill specific equipment gaps rather than to collect everything in one trip.",
  "Prepare storage space before arrival so high-value finds can be moved quickly.",
  "Avoid entering the route without a fallback vehicle path and enough supplies to leave immediately.",
];

const equipmentNotes = [
  "Weapons and equipment only matter if the survivor can safely carry them back to a stable base.",
  "Prioritize practical survival value over heavy or noisy gear that slows the return route.",
  "Treat every equipment run as optional once fatigue, injuries or surrounding pressure begin to rise.",
];

const riskRows = [
  { label: "Main threat", value: "Dense Louisville pressure and difficult exits" },
  { label: "Route risk", value: "High without transport and scouting" },
  { label: "Reward type", value: "Military-focused supplies and equipment upgrades" },
  { label: "Best timing", value: "After a stable base, vehicle and fallback route exist" },
];

const strategySteps = [
  "Scout the approach before committing to a full loot run.",
  "Bring only the gear needed for a fast objective, then leave space for priority loot.",
  "Keep the vehicle facing the exit route and avoid stopping deeper than necessary.",
  "End the run early if the route becomes blocked, noisy or fatigue-heavy.",
];

const basePotentialRows = [
  { label: "Base role", value: "Temporary staging point at best" },
  { label: "Long-term value", value: "Lower than safer dedicated base locations" },
  { label: "Recommended use", value: "Loot objective connected to an external base" },
  { label: "Better base link", value: "Compare with safer base ranking pages" },
];

const pros = [
  "Strong target for advanced equipment-focused runs",
  "Useful for players already operating around Louisville",
  "Good candidate for high-risk, high-reward loot planning",
  "Connects naturally with Louisville route and loot guide content",
];

const cons = [
  "Not beginner-friendly",
  "Requires transport, route discipline and fallback planning",
  "Poor choice for a first stable base compared with safer locations",
  "High pressure can make even successful loot runs expensive",
];

const faqs = [
  {
    question: "Is the Louisville military base good for beginners in Project Zomboid?",
    answer:
      "No. Players searching for Louisville military base routes should treat them as advanced objectives, not beginner starts.",
  },
  {
    question: "Is it worth looting military areas near Louisville?",
    answer:
      "It can be worth it for prepared players who need equipment upgrades, but the reward only matters if the return route is safe.",
  },
  {
    question: "Should I build a base there?",
    answer:
      "For most runs, it is better to use the area as a loot objective and keep the main base in a safer, more repeatable location.",
  },
];

const relatedGuides = [
  {
    title: "Louisville Location Guide",
    description: "Review Louisville difficulty, loot potential and advanced survival planning.",
    href: "/locations/louisville",
  },
  {
    title: "Best Loot Locations",
    description: "Compare loot routes by risk, reward and player experience.",
    href: "/guides/best-loot-locations",
  },
  {
    title: "Best Base Locations",
    description: "Compare safer long-term base candidates before committing to a risky area.",
    href: "/guides/best-base-locations/",
  },
];
---

<BaseLayout
  title="Louisville Military Base Project Zomboid Guide"
  description="Plan a Louisville military base route in Project Zomboid with military loot notes, weapon access, risk analysis and survival strategy."
  ogType="article"
  faqs={faqs}
>
  <section class="border-b border-zsd-line bg-zsd-black/45">
    <PageContainer class="py-12 sm:py-16">
      <p class="text-sm font-semibold text-zsd-orange">Location Database</p>
      <div class="mt-4 grid gap-6 lg:grid-cols-[1fr_380px] lg:items-end">
        <div>
          <h1 class="max-w-4xl text-4xl font-bold text-zsd-ash sm:text-5xl">
            Louisville Military Base Project Zomboid Guide
          </h1>
          <p class="mt-5 max-w-3xl text-base leading-7 text-zsd-muted">
            A high-risk Louisville planning page for military loot, weapons, equipment and route discipline.
          </p>
        </div>
        <StatsTable rows={locationStats.slice(0, 4)} />
      </div>
    </PageContainer>
  </section>

  <PageContainer as="section" class="py-12 sm:py-16">
    <div class="grid gap-8 lg:grid-cols-[1fr_360px] lg:items-start">
      <div>
        <section aria-labelledby="why-matters-title">
          <p class="text-sm font-semibold text-zsd-orange">Why this location matters</p>
          <h2 id="why-matters-title" class="mt-2 text-2xl font-semibold text-zsd-ash">
            A late-route objective for prepared Louisville survivors
          </h2>
          <p class="mt-4 text-base leading-7 text-zsd-muted">
            Players search for the Louisville military base because military-focused loot can change a run.
            The survival decision is whether the route is worth the pressure. This page frames the area as a
            planned objective for advanced players rather than a safe beginner destination.
          </p>
        </section>

        <section class="mt-10" aria-labelledby="overview-title">
          <p class="text-sm font-semibold text-zsd-orange">Location Overview</p>
          <h2 id="overview-title" class="mt-2 text-2xl font-semibold text-zsd-ash">
            How to evaluate the military route
          </h2>
          <div class="mt-5 grid gap-4 md:grid-cols-3">
            {overviewCards.map((item) => <Card title={item.title} description={item.description} />)}
          </div>
        </section>

        <section class="mt-10" aria-labelledby="military-loot-title">
          <p class="text-sm font-semibold text-zsd-orange">Military Loot</p>
          <h2 id="military-loot-title" class="mt-2 text-2xl font-semibold text-zsd-ash">
            Target specific supplies, then leave cleanly
          </h2>
          <div class="mt-5 grid gap-3">
            {
              militaryLootNotes.map((note) => (
                <div class="border border-zsd-line bg-zsd-panel/80 p-4 text-sm leading-6 text-zsd-muted">
                  {note}
                </div>
              ))
            }
          </div>
        </section>

        <section class="mt-10" aria-labelledby="equipment-title">
          <p class="text-sm font-semibold text-zsd-orange">Weapons & Equipment</p>
          <h2 id="equipment-title" class="mt-2 text-2xl font-semibold text-zsd-ash">
            Gear upgrades are only valuable if you survive the return
          </h2>
          <div class="mt-5 grid gap-3">
            {
              equipmentNotes.map((note) => (
                <div class="border border-zsd-line bg-zsd-panel/80 p-4 text-sm leading-6 text-zsd-muted">
                  {note}
                </div>
              ))
            }
          </div>
        </section>

        <section class="mt-10" aria-labelledby="strategy-title">
          <p class="text-sm font-semibold text-zsd-orange">Survival Strategy</p>
          <h2 id="strategy-title" class="mt-2 text-2xl font-semibold text-zsd-ash">
            Keep the objective narrow and the exit open
          </h2>
          <div class="mt-5 grid gap-3">
            {
              strategySteps.map((step, index) => (
                <div class="border border-zsd-line bg-zsd-panel/80 p-4 text-sm leading-6 text-zsd-muted">
                  <span class="font-semibold text-zsd-green-soft">Step {index + 1}: </span>
                  {step}
                </div>
              ))
            }
          </div>
        </section>
      </div>

      <aside class="grid gap-6">
        <section aria-labelledby="stats-title">
          <p class="text-sm font-semibold text-zsd-orange">Location Stats</p>
          <h2 id="stats-title" class="mt-2 text-xl font-semibold text-zsd-ash">Decision snapshot</h2>
          <div class="mt-4">
            <StatsTable rows={locationStats} />
          </div>
        </section>

        <section aria-labelledby="risk-title">
          <p class="text-sm font-semibold text-zsd-orange">Risk Analysis</p>
          <h2 id="risk-title" class="mt-2 text-xl font-semibold text-zsd-ash">Route pressure</h2>
          <div class="mt-4">
            <StatsTable rows={riskRows} />
          </div>
        </section>

        <section aria-labelledby="base-potential-title">
          <p class="text-sm font-semibold text-zsd-orange">Base Potential</p>
          <h2 id="base-potential-title" class="mt-2 text-xl font-semibold text-zsd-ash">Best use case</h2>
          <div class="mt-4">
            <StatsTable rows={basePotentialRows} />
          </div>
        </section>
      </aside>
    </div>

    <section class="mt-12" aria-labelledby="pros-cons-title">
      <div class="grid gap-4 md:grid-cols-2">
        <div class="border border-zsd-line bg-zsd-panel/80 p-5">
          <p class="text-sm font-semibold text-zsd-orange">Pros</p>
          <h2 id="pros-cons-title" class="mt-2 text-2xl font-semibold text-zsd-ash">
            Why target this Louisville route
          </h2>
          <ul class="mt-5 grid gap-3 text-sm leading-6 text-zsd-muted">
            {pros.map((item) => <li class="border border-zsd-line/80 bg-zsd-black/35 p-3">{item}</li>)}
          </ul>
        </div>
        <div class="border border-zsd-line bg-zsd-panel/80 p-5">
          <p class="text-sm font-semibold text-zsd-orange">Cons</p>
          <h2 class="mt-2 text-2xl font-semibold text-zsd-ash">Tradeoffs to plan around</h2>
          <ul class="mt-5 grid gap-3 text-sm leading-6 text-zsd-muted">
            {cons.map((item) => <li class="border border-zsd-line/80 bg-zsd-black/35 p-3">{item}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="mt-12" aria-labelledby="faq-title">
      <div class="mb-6">
        <p class="text-sm font-semibold text-zsd-orange">FAQ</p>
        <h2 id="faq-title" class="mt-2 text-2xl font-semibold text-zsd-ash">Louisville military route questions</h2>
      </div>
      <div class="grid gap-4">
        {
          faqs.map((item) => (
            <article class="border border-zsd-line bg-zsd-panel/80 p-5">
              <h3 class="text-lg font-semibold text-zsd-ash">{item.question}</h3>
              <p class="mt-3 text-sm leading-6 text-zsd-muted">{item.answer}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="mt-12" aria-labelledby="related-guides-title">
      <div class="mb-6">
        <p class="text-sm font-semibold text-zsd-orange">Related Guides</p>
        <h2 id="related-guides-title" class="mt-2 text-2xl font-semibold text-zsd-ash">
          Continue Louisville planning
        </h2>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        {relatedGuides.map((guide) => <Card {...guide} label="Open guide" />)}
      </div>
    </section>
  </PageContainer>
</BaseLayout>
