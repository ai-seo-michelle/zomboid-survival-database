---
import Card from "../../components/Card.astro";
import PageContainer from "../../components/PageContainer.astro";
import StatsTable from "../../components/StatsTable.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const locationStats = [
  { label: "Area", value: "Rosewood" },
  { label: "Building Type", value: "Fire station loot target" },
  { label: "Difficulty", value: "Easy-Medium" },
  { label: "Recommended For", value: "Beginners" },
  { label: "Loot Focus", value: "Firefighter gear and utility" },
  { label: "Base Link", value: "High" },
];

const overviewCards = [
  {
    title: "Gear and Base Utility",
    description:
      "Rosewood Fire Station is valuable because its loot can support early defense, storage and practical base setup.",
  },
  {
    title: "Beginner-Friendly Target",
    description:
      "The location works well for new players because it connects useful loot with a strong Rosewood base route.",
  },
  {
    title: "Short Route Value",
    description:
      "It is best looted through short, controlled trips instead of one overloaded run that risks fatigue and noise.",
  },
];

const firefighterGearNotes = [
  "Prioritize firefighter clothing and protective gear when it supports the route without adding too much weight.",
  "Use the station as a place to collect practical equipment before expanding into wider Rosewood looting.",
  "Move gear back to organized storage so future runs are not slowed by sorting during danger.",
];

const weaponPotentialNotes = [
  "Fire station loot can support early melee planning, especially when the survivor needs reliable utility tools.",
  "Treat any weapon find as part of the base plan, not a reason to start clearing the whole town.",
  "Pair weapon pickups with food, water and medical supplies so the run stays balanced.",
];

const lootCategories = [
  {
    title: "Firefighter Gear",
    description:
      "Useful protective clothing and station-related equipment for players preparing safer early routes.",
  },
  {
    title: "Weapons and Tools",
    description:
      "Utility-focused finds can help with defense, base setup and controlled Rosewood exploration.",
  },
  {
    title: "Storage Support",
    description:
      "The building works best when loot is moved into a clear storage system for repeated supply runs.",
  },
  {
    title: "Base Supplies",
    description:
      "Loot value is strongest when it supports the fire station as a safehouse, not just a one-time stop.",
  },
];

const safeEntryRows = [
  { label: "First check", value: "Nearby streets and visible entry pressure" },
  { label: "Main risk", value: "Overstaying after finding useful gear" },
  { label: "Best timing", value: "Early, after the immediate area is manageable" },
  { label: "Exit rule", value: "Leave before fatigue or noise changes the route" },
];

const lootRoute = [
  "Secure the outside approach before entering the building.",
  "Check priority rooms for gear, tools and useful supplies.",
  "Move important loot into organized storage instead of carrying too much.",
  "Return later for lower-priority items after the route is stable.",
];

const survivalTips = [
  "Keep the fire station route short until the surrounding streets are familiar.",
  "Do not let strong loot make you skip food, water and medical planning.",
  "Use the building as a base hub only after entrances and nearby movement are controlled.",
  "Connect this loot route with Rosewood town routes rather than pushing into every nearby building at once.",
];

const pros = [
  "Strong early loot value for Rosewood players",
  "Useful firefighter gear and utility-focused supplies",
  "Pairs naturally with one of the best beginner base locations",
  "Supports short, repeatable supply routes",
];

const cons = [
  "Good loot can encourage players to carry too much at once",
  "Still requires local area control before it feels safe",
  "Does not replace wider food, medical and tool planning",
  "Noise and fatigue can turn a simple loot run into a risky return",
];

const faqs = [
  {
    question: "Is Rosewood Fire Station good for loot in Project Zomboid?",
    answer:
      "Yes. It is one of the most useful Rosewood targets because it can support base setup, firefighter gear, utility tools and early route planning.",
  },
  {
    question: "Should beginners loot Rosewood Fire Station early?",
    answer:
      "Beginners can loot it early if they keep the route short, check the surrounding area and avoid carrying more than they can safely move.",
  },
  {
    question: "Is Rosewood Fire Station better as a base or loot stop?",
    answer:
      "It can work as both. The strongest plan is to secure it as a base candidate, then use its loot and storage potential to support repeatable Rosewood runs.",
  },
];

const relatedGuides = [
  {
    title: "Rosewood Map Guide",
    description: "Return to the town-level Rosewood hub for routes, POIs and base planning.",
    href: "/locations/rosewood/",
  },
  {
    title: "Rosewood Fire Station Base",
    description: "Review the full base guide before turning this loot target into a long-term safehouse.",
    href: "/locations/rosewood-fire-station/"
  },
  {
    title: "Best Weapons",
    description: "Compare weapon choices before deciding what is worth carrying from the station.",
    href: "/guides/best-weapons",
  },
  {
    title: "Best Loot Locations",
    description: "Compare Rosewood Fire Station with other high-value loot routes.",
    href: "/guides/best-loot-locations",
  },
  {
    title: "Best Base Locations",
    description: "See how Rosewood Fire Station fits into broader base ranking decisions.",
    href: "/guides/best-base-locations/",
  },
  {
    title: "Project Zomboid Map Guide",
    description: "Use map planning to connect Rosewood routes, bases and loot targets.",
    href: "/guides/project-zomboid-map/",
  },
];
---

<BaseLayout
  title="Rosewood Fire Station Loot Guide"
  description="Plan Rosewood Fire Station loot in Project Zomboid with firefighter gear notes, weapon potential, safe entry strategy, loot routes and survival tips."
  ogType="article"
  faqs={faqs}
>
  <section class="border-b border-zsd-line bg-zsd-black/45">
    <PageContainer class="py-12 sm:py-16">
      <p class="text-sm font-semibold text-zsd-orange">Building Loot Guide</p>
      <div class="mt-4 grid gap-6 lg:grid-cols-[1fr_380px] lg:items-end">
        <div>
          <h1 class="max-w-4xl text-4xl font-bold text-zsd-ash sm:text-5xl">
            Rosewood Fire Station Loot Guide
          </h1>
          <p class="mt-5 max-w-3xl text-base leading-7 text-zsd-muted">
            A focused Project Zomboid loot page for firefighter gear, weapon potential and safe Rosewood Fire
            Station supply routes.
          </p>
        </div>
        <StatsTable rows={locationStats.slice(0, 4)} />
      </div>
    </PageContainer>
  </section>

  <PageContainer as="section" class="py-12 sm:py-16">
    <div class="grid gap-8 lg:grid-cols-[1fr_360px] lg:items-start">
      <div>
        <section aria-labelledby="why-visit-title">
          <p class="text-sm font-semibold text-zsd-orange">Why players visit Rosewood Fire Station</p>
          <h2 id="why-visit-title" class="mt-2 text-2xl font-semibold text-zsd-ash">
            Loot that supports both survival and base setup
          </h2>
          <p class="mt-4 text-base leading-7 text-zsd-muted">
            Players visit Rosewood Fire Station because the building combines practical loot with one of
            Rosewood's strongest base candidates. The best approach is to collect high-value gear, secure
            storage and keep each loot run recoverable.
          </p>
        </section>

        <section class="mt-10" aria-labelledby="overview-title">
          <p class="text-sm font-semibold text-zsd-orange">Location Overview</p>
          <h2 id="overview-title" class="mt-2 text-2xl font-semibold text-zsd-ash">
            How this loot route fits into Rosewood
          </h2>
          <div class="mt-5 grid gap-4 md:grid-cols-3">
            {overviewCards.map((item) => <Card title={item.title} description={item.description} />)}
          </div>
        </section>

        <section class="mt-10" aria-labelledby="gear-title">
          <p class="text-sm font-semibold text-zsd-orange">Firefighter Gear Loot</p>
          <h2 id="gear-title" class="mt-2 text-2xl font-semibold text-zsd-ash">
            Prioritize useful protection and utility
          </h2>
          <div class="mt-5 grid gap-3">
            {
              firefighterGearNotes.map((note) => (
                <div class="border border-zsd-line bg-zsd-panel/80 p-4 text-sm leading-6 text-zsd-muted">
                  {note}
                </div>
              ))
            }
          </div>
        </section>

        <section class="mt-10" aria-labelledby="weapon-title">
          <p class="text-sm font-semibold text-zsd-orange">Weapon Potential</p>
          <h2 id="weapon-title" class="mt-2 text-2xl font-semibold text-zsd-ash">
            Use weapon finds to support the route
          </h2>
          <div class="mt-5 grid gap-3">
            {
              weaponPotentialNotes.map((note) => (
                <div class="border border-zsd-line bg-zsd-panel/80 p-4 text-sm leading-6 text-zsd-muted">
                  {note}
                </div>
              ))
            }
          </div>
        </section>

        <section class="mt-10" aria-labelledby="route-title">
          <p class="text-sm font-semibold text-zsd-orange">Best Loot Route</p>
          <h2 id="route-title" class="mt-2 text-2xl font-semibold text-zsd-ash">
            Keep the route short and repeatable
          </h2>
          <div class="mt-5 grid gap-3">
            {
              lootRoute.map((step, index) => (
                <div class="border border-zsd-line bg-zsd-panel/80 p-4 text-sm leading-6 text-zsd-muted">
                  <span class="font-semibold text-zsd-green-soft">Route step {index + 1}: </span>
                  {step}
                </div>
              ))
            }
          </div>
        </section>

        <section class="mt-10" aria-labelledby="tips-title">
          <p class="text-sm font-semibold text-zsd-orange">Survival Tips</p>
          <h2 id="tips-title" class="mt-2 text-2xl font-semibold text-zsd-ash">
            Make the loot route serve the base plan
          </h2>
          <div class="mt-5 grid gap-3">
            {
              survivalTips.map((tip) => (
                <div class="border border-zsd-line bg-zsd-panel/80 p-4 text-sm leading-6 text-zsd-muted">
                  {tip}
                </div>
              ))
            }
          </div>
        </section>
      </div>

      <aside class="grid gap-6">
        <section aria-labelledby="stats-title">
          <p class="text-sm font-semibold text-zsd-orange">Loot Snapshot</p>
          <h2 id="stats-title" class="mt-2 text-xl font-semibold text-zsd-ash">Decision stats</h2>
          <div class="mt-4">
            <StatsTable rows={locationStats} />
          </div>
        </section>

        <section aria-labelledby="categories-title">
          <p class="text-sm font-semibold text-zsd-orange">Loot Categories</p>
          <h2 id="categories-title" class="mt-2 text-xl font-semibold text-zsd-ash">What to look for</h2>
          <div class="mt-4 grid gap-3">
            {lootCategories.map((item) => <Card title={item.title} description={item.description} />)}
          </div>
        </section>

        <section aria-labelledby="safe-entry-title">
          <p class="text-sm font-semibold text-zsd-orange">Safe Entry Strategy</p>
          <h2 id="safe-entry-title" class="mt-2 text-xl font-semibold text-zsd-ash">Entry checks</h2>
          <div class="mt-4">
            <StatsTable rows={safeEntryRows} />
          </div>
        </section>
      </aside>
    </div>

    <section class="mt-12" aria-labelledby="pros-cons-title">
      <div class="grid gap-4 md:grid-cols-2">
        <div class="border border-zsd-line bg-zsd-panel/80 p-5">
          <p class="text-sm font-semibold text-zsd-orange">Pros</p>
          <h2 id="pros-cons-title" class="mt-2 text-2xl font-semibold text-zsd-ash">
            Why loot Rosewood Fire Station
          </h2>
          <ul class="mt-5 grid gap-3 text-sm leading-6 text-zsd-muted">
            {pros.map((item) => <li class="border border-zsd-line/80 bg-zsd-black/35 p-3">{item}</li>)}
          </ul>
        </div>
        <div class="border border-zsd-line bg-zsd-panel/80 p-5">
          <p class="text-sm font-semibold text-zsd-orange">Cons</p>
          <h2 class="mt-2 text-2xl font-semibold text-zsd-ash">Tradeoffs to plan around</h2>
          <ul class="mt-5 grid gap-3 text-sm leading-6 text-zsd-muted">
            {cons.map((item) => <li class="border border-zsd-line/80 bg-zsd-black/35 p-3">{item}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="mt-12" aria-labelledby="faq-title">
      <div class="mb-6">
        <p class="text-sm font-semibold text-zsd-orange">FAQ</p>
        <h2 id="faq-title" class="mt-2 text-2xl font-semibold text-zsd-ash">Rosewood Fire Station loot questions</h2>
      </div>
      <div class="grid gap-4">
        {
          faqs.map((item) => (
            <article class="border border-zsd-line bg-zsd-panel/80 p-5">
              <h3 class="text-lg font-semibold text-zsd-ash">{item.question}</h3>
              <p class="mt-3 text-sm leading-6 text-zsd-muted">{item.answer}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="mt-12" aria-labelledby="related-guides-title">
      <div class="mb-6">
        <p class="text-sm font-semibold text-zsd-orange">Related Guides</p>
        <h2 id="related-guides-title" class="mt-2 text-2xl font-semibold text-zsd-ash">
          Continue Rosewood loot planning
        </h2>
      </div>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {relatedGuides.map((guide) => <Card {...guide} label="Open guide" />)}
      </div>
    </section>
  </PageContainer>
</BaseLayout>
