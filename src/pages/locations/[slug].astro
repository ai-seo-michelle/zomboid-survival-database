---
import Card from "../../components/Card.astro";
import LocationCard from "../../components/LocationCard.astro";
import PageContainer from "../../components/PageContainer.astro";
import StatsTable from "../../components/StatsTable.astro";
import { locations } from "../../data/locations";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { LocationRecord } from "../../types/location";

export function getStaticPaths() {
  return locations.map((location) => ({
    params: { slug: location.slug },
    props: { location },
  }));
}

const { location } = Astro.props as { location: LocationRecord };

const stats = [
  { label: "Difficulty", value: location.difficulty },
  { label: "Recommended For", value: location.recommendedFor },
  { label: "Security", value: location.security },
  { label: "Resources", value: location.resources },
  { label: "Base Rating", value: `${location.baseRating}/5` },
  { label: "Loot Rating", value: `${location.lootRating}/5` },
  { label: "Risk Rating", value: `${location.riskRating}/5` },
];
---

<BaseLayout title={location.seo.title} description={location.seo.description}>
  <section class="border-b border-zsd-line bg-zsd-black/45">
    <PageContainer class="py-12 sm:py-16">
      <p class="text-sm font-semibold text-zsd-orange">Location Database</p>
      <div class="mt-4 grid gap-6 lg:grid-cols-[1fr_340px] lg:items-end">
        <div>
          <h1 class="max-w-4xl text-4xl font-bold text-zsd-ash sm:text-5xl">
            {location.seo.title}
          </h1>
          <p class="mt-5 max-w-3xl text-base leading-7 text-zsd-muted">
            {location.description}
          </p>
        </div>
        <StatsTable
          rows={[
            { label: "Difficulty", value: location.difficulty },
            { label: "Recommended Player", value: location.recommendedFor },
            { label: "Security", value: location.security },
            { label: "Resources", value: location.resources },
          ]}
        />
      </div>
    </PageContainer>
  </section>

  <PageContainer as="section" class="py-12 sm:py-16">
    <div class="grid gap-8 lg:grid-cols-[1fr_360px] lg:items-start">
      <div>
        <section aria-labelledby="rosewood-overview">
          <p class="text-sm font-semibold text-zsd-orange">{location.name} Overview</p>
          <h2 id="rosewood-overview" class="mt-2 text-2xl font-semibold text-zsd-ash">
            Why this location works
          </h2>
          <p class="mt-4 text-base leading-7 text-zsd-muted">{location.overview}</p>
        </section>

        <section class="mt-10" aria-labelledby="best-base-spots">
          <p class="text-sm font-semibold text-zsd-orange">Best Base Spots</p>
          <h2 id="best-base-spots" class="mt-2 text-2xl font-semibold text-zsd-ash">
            Base candidates in {location.name}
          </h2>
          <div class="mt-5 grid gap-4">
            {
              location.bestBases.map((base, index) => (
                <LocationCard
                  title={base.name}
                  description={base.description}
                  badge={`#${index + 1}`}
                  meta={[
                    { label: "Safety", value: base.safety },
                    { label: "Resources", value: base.resources },
                    { label: "Difficulty", value: base.difficulty },
                    { label: "Recommended", value: base.recommendedFor },
                  ]}
                />
              ))
            }
          </div>
        </section>

        <section class="mt-10" aria-labelledby="loot-resources">
          <p class="text-sm font-semibold text-zsd-orange">Loot & Resources</p>
          <h2 id="loot-resources" class="mt-2 text-2xl font-semibold text-zsd-ash">
            Resource planning notes
          </h2>
          <div class="mt-5 grid gap-3">
            {
              location.lootAndResources.map((note) => (
                <div class="border border-zsd-line bg-zsd-panel/80 p-4 text-sm leading-6 text-zsd-muted">
                  {note}
                </div>
              ))
            }
          </div>
        </section>

        <section class="mt-10" aria-labelledby="survival-strategy">
          <p class="text-sm font-semibold text-zsd-orange">Survival Strategy</p>
          <h2 id="survival-strategy" class="mt-2 text-2xl font-semibold text-zsd-ash">
            How to approach {location.name}
          </h2>
          <div class="mt-5 grid gap-3">
            {
              location.survivalStrategy.map((note) => (
                <div class="border border-zsd-line bg-zsd-panel/80 p-4 text-sm leading-6 text-zsd-muted">
                  {note}
                </div>
              ))
            }
          </div>
        </section>
      </div>

      <aside class="grid gap-6">
        <section aria-labelledby="location-stats">
          <p class="text-sm font-semibold text-zsd-orange">Location Stats</p>
          <h2 id="location-stats" class="mt-2 text-xl font-semibold text-zsd-ash">Decision snapshot</h2>
          <div class="mt-4">
            <StatsTable rows={stats} />
          </div>
        </section>

        <section aria-labelledby="key-locations">
          <p class="text-sm font-semibold text-zsd-orange">Key Locations</p>
          <h2 id="key-locations" class="mt-2 text-xl font-semibold text-zsd-ash">Places to check</h2>
          <div class="mt-4 grid gap-3">
            {
              location.keyLocations.map((keyLocation) => (
                <div class="border border-zsd-line bg-zsd-panel/80 p-4">
                  <p class="text-sm font-semibold text-zsd-ash">{keyLocation}</p>
                </div>
              ))
            }
          </div>
        </section>
      </aside>
    </div>

    <section class="mt-12" aria-labelledby="pros-cons">
      <div class="grid gap-4 md:grid-cols-2">
        <div class="border border-zsd-line bg-zsd-panel/80 p-5">
          <p class="text-sm font-semibold text-zsd-orange">Pros</p>
          <h2 id="pros-cons" class="mt-2 text-2xl font-semibold text-zsd-ash">Why choose {location.name}</h2>
          <ul class="mt-5 grid gap-3 text-sm leading-6 text-zsd-muted">
            {location.pros.map((pro) => <li class="border border-zsd-line/80 bg-zsd-black/35 p-3">{pro}</li>)}
          </ul>
        </div>
        <div class="border border-zsd-line bg-zsd-panel/80 p-5">
          <p class="text-sm font-semibold text-zsd-orange">Cons</p>
          <h2 class="mt-2 text-2xl font-semibold text-zsd-ash">Tradeoffs to plan around</h2>
          <ul class="mt-5 grid gap-3 text-sm leading-6 text-zsd-muted">
            {location.cons.map((con) => <li class="border border-zsd-line/80 bg-zsd-black/35 p-3">{con}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="mt-12" aria-labelledby="related-guides-title">
      <div class="mb-6">
        <p class="text-sm font-semibold text-zsd-orange">Related Guides</p>
        <h2 id="related-guides-title" class="mt-2 text-2xl font-semibold text-zsd-ash">
          Continue survival planning
        </h2>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        {
          location.relatedGuides.map((guide) => (
            <Card title={guide.title} description={guide.description} href={guide.href} label="Open guide" />
          ))
        }
      </div>
    </section>
  </PageContainer>
</BaseLayout>
