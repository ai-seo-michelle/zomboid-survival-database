---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/Card.astro";
import PageContainer from "../../components/PageContainer.astro";
import RankingTable from "../../components/RankingTable.astro";
import StatsTable from "../../components/StatsTable.astro";
import { locations } from "../../data/locations";
import mapsData from "../../data/maps.json";
import type { MapRankingRecord } from "../../types/map";

const rankings = mapsData as MapRankingRecord[];
const mapChallengeBySlug = new Map(rankings.map((location) => [location.slug, location.challenge]));

const planningRoles: Record<string, string> = {
  rosewood: "Beginner-friendly first town",
  riverside: "Calmer early route planning",
  muldraugh: "Intermediate route-control practice",
  "west-point": "Experienced town challenge",
  louisville: "Advanced city objective",
};

const difficultyRankings = locations
  .map((location) => ({
    ...location,
    challenge: mapChallengeBySlug.get(location.slug) ?? location.description,
    planningRole: planningRoles[location.slug] ?? "Location planning",
  }))
  .sort((a, b) => a.riskRating - b.riskRating || b.baseRating - a.baseRating || b.lootRating - a.lootRating);

const rankingColumns = [
  { key: "rank", label: "Rank" },
  { key: "difficulty", label: "Difficulty" },
  { key: "recommendedFor", label: "Recommended For" },
  { key: "riskRating", label: "Risk" },
  { key: "lootRating", label: "Loot" },
  { key: "baseRating", label: "Base" },
  { key: "planningRole", label: "Best Use" },
];

const rankingRows = difficultyRankings.map((location, index) => ({
  title: location.name,
  href: `/locations/${location.slug}/`,
  values: {
    rank: `#${index + 1}`,
    difficulty: location.difficulty,
    recommendedFor: location.recommendedFor,
    riskRating: `${location.riskRating}/5`,
    lootRating: `${location.lootRating}/5`,
    baseRating: `${location.baseRating}/5`,
    planningRole: location.planningRole,
  },
}));

const quickVerdicts = [
  {
    title: "Easiest Overall",
    description:
      "Rosewood is the clearest easy pick in the current database because it combines low risk, strong base value and a readable town layout.",
    href: "/locations/rosewood/",
    stats: [
      { label: "Town", value: "Rosewood" },
      { label: "Best Fit", value: "First serious runs" },
    ],
  },
  {
    title: "Best for Beginners",
    description:
      "Rosewood is the safest first recommendation, while Riverside is a strong alternative for players who want a slower pace.",
    href: "/guides/best-starting-location/",
    stats: [
      { label: "Primary Pick", value: "Rosewood" },
      { label: "Alternative", value: "Riverside" },
    ],
  },
  {
    title: "Best Balanced Start",
    description:
      "Riverside offers a calmer route plan with steady supplies, making it useful when you want less pressure than harder towns.",
    href: "/locations/riverside/",
    stats: [
      { label: "Town", value: "Riverside" },
      { label: "Best Fit", value: "Cautious starts" },
    ],
  },
  {
    title: "Best for Loot",
    description:
      "Louisville has the highest loot rating in the current data, but it should be treated as an advanced objective with higher risk.",
    href: "/locations/louisville/",
    stats: [
      { label: "Area", value: "Louisville" },
      { label: "Risk", value: "5/5" },
    ],
  },
  {
    title: "Best for Experienced Players",
    description:
      "West Point is a harder town-style challenge where route discipline, exits and pressure management matter more.",
    href: "/locations/west-point/",
    stats: [
      { label: "Town", value: "West Point" },
      { label: "Best Fit", value: "Route planners" },
    ],
  },
  {
    title: "Hardest Area",
    description:
      "Louisville is the hardest current area in this database because its loot value comes with dense city pressure and longer routes.",
    href: "/locations/louisville/",
    stats: [
      { label: "Area", value: "Louisville" },
      { label: "Difficulty", value: "Hard" },
    ],
  },
];

const criteriaRows = [
  { label: "Risk Rating", value: "How punishing the area can become when routes, noise or exits go wrong" },
  { label: "Base Rating", value: "How useful the area is for stable safehouse and long-term base planning" },
  { label: "Loot Rating", value: "How much supply value the area can offer relative to its danger" },
  { label: "Recommended For", value: "Which player experience level the area best supports" },
  { label: "Route Pressure", value: "How much the area rewards short runs, escape planning and vehicle access" },
  { label: "Early Survivability", value: "How forgiving the town feels before the first base is stable" },
];

const easiestAreas = difficultyRankings.filter((location) => location.difficulty === "Easy");
const hardestAreas = difficultyRankings.filter((location) => location.difficulty === "Hard");

const recommendationRows = [
  { label: "Safest first pick", value: "Rosewood" },
  { label: "Cautious alternative", value: "Riverside" },
  { label: "Intermediate step", value: "Muldraugh" },
  { label: "Experienced town challenge", value: "West Point" },
  { label: "Advanced city objective", value: "Louisville" },
];

const faqs = [
  {
    question: "What is the easiest starting town in Project Zomboid?",
    answer:
      "Rosewood is the easiest current pick in this database because it has low risk, strong base options and a compact layout that is easier to learn.",
  },
  {
    question: "Which Project Zomboid town is best for beginners?",
    answer:
      "Rosewood is the safest first recommendation. Riverside is also beginner-friendly if you want a slower, more cautious route plan.",
  },
  {
    question: "What is the hardest starting town or area?",
    answer:
      "West Point is the harder town-style challenge in this comparison. Louisville is the hardest overall area in the current database and is better treated as an advanced objective.",
  },
  {
    question: "Which town has the best loot?",
    answer:
      "Louisville has the highest loot rating in the current data, while West Point also has strong loot potential. Both require more route planning than Rosewood or Riverside.",
  },
  {
    question: "Is this difficulty ranking for Build 42?",
    answer:
      "Yes. The page is written for current Build 42 planning, but it avoids exact population, spawn or loot claims that may vary by save settings or updates.",
  },
];

const relatedPages = [
  {
    title: "Build 42 Map Guide",
    description: "Use the main map guide for Build 42 town planning before comparing difficulty.",
    href: "/guides/project-zomboid-map/",
  },
  {
    title: "Interactive Map",
    description: "Use the map hub as the starting point for routes, areas and future filters.",
    href: "/maps/interactive-map/",
  },
  {
    title: "Best Base Locations",
    description: "Compare future base picks by safety, access and long-term survival value.",
    href: "/survival/best-base-locations/",
  },
  {
    title: "Best Loot Locations",
    description: "Compare loot routes after choosing how much risk your starting area can handle.",
    href: "/guides/best-loot-locations/",
  },
  {
    title: "Best Starting Location",
    description: "Use the recommendation guide when you want a direct answer for where to start.",
    href: "/guides/best-starting-location/",
  },
  {
    title: "Location Database",
    description: "Open the full location database for town-specific base, loot and route notes.",
    href: "/locations/",
  },
  {
    title: "Rosewood Guide",
    description: "Open the Rosewood location page for base and route planning.",
    href: "/locations/rosewood/",
  },
  {
    title: "Riverside Guide",
    description: "Review a calmer town option for cautious early route planning.",
    href: "/locations/riverside/",
  },
  {
    title: "West Point Guide",
    description: "Review a harder town where route discipline matters more.",
    href: "/locations/west-point/",
  },
  {
    title: "Louisville Guide",
    description: "Open the Louisville location page for high-risk city survival planning.",
    href: "/locations/louisville/",
  },
];
---

<BaseLayout
  title="Project Zomboid Map Difficulty Ranking | Best Starting Towns"
  description="Compare Project Zomboid towns by difficulty, beginner safety, loot access, base options and Build 42 route pressure before choosing where to start."
  canonicalPath="/maps/difficulty-ranking/"
  ogType="article"
  faqs={faqs}
>
  <PageContainer as="section" class="py-12 sm:py-16">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold text-zsd-orange">Map Difficulty Ranking</p>
      <h1 class="mt-3 text-4xl font-bold text-zsd-ash">Project Zomboid Map Difficulty Ranking</h1>
      <p class="mt-5 text-base leading-7 text-zsd-muted">
        Different Project Zomboid towns suit different survival styles. This Build 42 comparison focuses on
        difficulty, risk, loot access, base options and route pressure so you can choose where to start before
        committing to a longer survival plan.
      </p>
    </div>

    <section class="mt-12" aria-labelledby="quick-verdict-title">
      <div class="mb-6">
        <p class="text-sm font-semibold text-zsd-orange">Quick Verdict</p>
        <h2 id="quick-verdict-title" class="mt-2 text-2xl font-semibold text-zsd-ash">
          Best starting towns by player need
        </h2>
        <p class="mt-3 max-w-3xl text-sm leading-6 text-zsd-muted">
          Use these picks as shortcuts, not absolute rules. They summarize the current database and link into
          town pages where you can review base planning, loot notes and route pressure.
        </p>
      </div>
      <div class="grid gap-4 lg:grid-cols-3">
        {quickVerdicts.map((pick) => <Card {...pick} label="View Guide" eyebrow="Quick Pick" />)}
      </div>
    </section>

    <section class="mt-12" aria-labelledby="comparison-table-title">
      <div class="mb-6">
        <p class="text-sm font-semibold text-zsd-orange">Map Difficulty Comparison Table</p>
        <h2 id="comparison-table-title" class="mt-2 text-2xl font-semibold text-zsd-ash">
          Compare towns before choosing where to start
        </h2>
      </div>
      <RankingTable columns={rankingColumns} rows={rankingRows} titleLabel="Town / Area" />
    </section>

    <section class="mt-12" aria-labelledby="ranking-title">
      <div class="mb-6 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="text-sm font-semibold text-zsd-orange">Difficulty Ranking</p>
          <h2 id="ranking-title" class="mt-2 text-2xl font-semibold text-zsd-ash">Current database ranking</h2>
        </div>
        <p class="max-w-xl text-sm leading-6 text-zsd-muted">
          The order is based on the site's existing difficulty, base, loot and risk data. It is meant for
          planning, not for precise spawn math or guaranteed in-game outcomes.
        </p>
      </div>

      <div class="grid gap-4 lg:grid-cols-2">
        {
          difficultyRankings.map((location, index) => (
            <Card
              title={location.name}
              description={`Challenge: ${location.challenge}`}
              href={`/locations/${location.slug}/`}
              label="View Guide"
              eyebrow="Difficulty Card"
              badge={`#${index + 1}`}
              stats={[
                { label: "Difficulty", value: location.difficulty },
                { label: "Recommended For", value: location.recommendedFor },
                { label: "Risk", value: `${location.riskRating}/5` },
                { label: "Best Use", value: location.planningRole },
              ]}
            />
          ))
        }
      </div>
    </section>

    <section class="mt-12" aria-labelledby="criteria-title">
      <div class="grid gap-6 lg:grid-cols-[1fr_440px] lg:items-start">
        <div>
          <p class="text-sm font-semibold text-zsd-orange">What This Difficulty Ranking Means</p>
          <h2 id="criteria-title" class="mt-2 text-2xl font-semibold text-zsd-ash">
            Difficulty is more than a single score
          </h2>
          <p class="mt-4 text-sm leading-6 text-zsd-muted">
            A town can be easy because routes are readable, because base options are strong or because early
            mistakes are easier to recover from. Harder areas usually offer stronger loot or progression value,
            but they ask for better exits, vehicle planning and discipline before the first base is stable.
          </p>
        </div>
        <StatsTable rows={criteriaRows} />
      </div>
    </section>

    <section class="mt-12" aria-labelledby="easy-title">
      <div class="mb-6">
        <p class="text-sm font-semibold text-zsd-orange">Easiest Map Areas</p>
        <h2 id="easy-title" class="mt-2 text-2xl font-semibold text-zsd-ash">
          Best difficulty for new players
        </h2>
        <p class="mt-3 max-w-3xl text-sm leading-6 text-zsd-muted">
          Easy areas are better for learning safe routes, supply loops and base setup before testing harder towns.
        </p>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        {
          easiestAreas.map((location) => (
            <Card
              title={location.name}
              description={location.description}
              href={`/locations/${location.slug}/`}
              label="Open location"
              eyebrow="Easy Area"
              stats={[
                { label: "Recommended For", value: location.recommendedFor },
                { label: "Risk", value: `${location.riskRating}/5` },
              ]}
            />
          ))
        }
      </div>
    </section>

    <section class="mt-12" aria-labelledby="hard-title">
      <div class="mb-6">
        <p class="text-sm font-semibold text-zsd-orange">Hardest Map Areas</p>
        <h2 id="hard-title" class="mt-2 text-2xl font-semibold text-zsd-ash">
          Better for experienced players
        </h2>
        <p class="mt-3 max-w-3xl text-sm leading-6 text-zsd-muted">
          Harder areas can be rewarding, but the current database treats them as planned objectives rather than
          relaxed first choices.
        </p>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        {
          hardestAreas.map((location) => (
            <Card
              title={location.name}
              description={location.description}
              href={`/locations/${location.slug}/`}
              label="Open location"
              eyebrow="Hard Area"
              stats={[
                { label: "Recommended For", value: location.recommendedFor },
                { label: "Loot", value: `${location.lootRating}/5` },
                { label: "Risk", value: `${location.riskRating}/5` },
              ]}
            />
          ))
        }
      </div>
    </section>

    <section class="mt-12" aria-labelledby="recommendation-title">
      <div class="grid gap-6 lg:grid-cols-[1fr_420px] lg:items-start">
        <div>
          <p class="text-sm font-semibold text-zsd-orange">Beginner vs Veteran Recommendations</p>
          <h2 id="recommendation-title" class="mt-2 text-2xl font-semibold text-zsd-ash">
            Choose the pressure level you can recover from
          </h2>
          <p class="mt-4 text-sm leading-6 text-zsd-muted">
            Newer players should usually start where mistakes are recoverable: Rosewood first, Riverside if you
            prefer slower movement. Muldraugh sits in the middle. West Point and Louisville become stronger once
            you already understand route control, fatigue, vehicles and when to abandon a run objective.
          </p>
        </div>
        <StatsTable rows={recommendationRows} />
      </div>
    </section>

    <section class="mt-12" aria-labelledby="build-42-title">
      <div class="border border-zsd-line bg-zsd-panel/80 p-6">
        <p class="text-sm font-semibold text-zsd-orange">Build 42 Notes</p>
        <h2 id="build-42-title" class="mt-2 text-2xl font-semibold text-zsd-ash">
          Use the ranking as a planning layer
        </h2>
        <p class="mt-4 text-sm leading-6 text-zsd-muted">
          This page is written for current Build 42 planning, but it does not claim exact zombie population,
          spawn behavior or loot tables. Treat the ranking as a decision guide for town difficulty, then verify
          the specific route in your save before committing.
        </p>
      </div>
    </section>

    <section class="mt-12" aria-labelledby="faq-title">
      <div class="mb-6">
        <p class="text-sm font-semibold text-zsd-orange">FAQ</p>
        <h2 id="faq-title" class="mt-2 text-2xl font-semibold text-zsd-ash">Map difficulty questions</h2>
      </div>
      <div class="grid gap-4">
        {
          faqs.map((item) => (
            <article class="border border-zsd-line bg-zsd-panel/80 p-5">
              <h3 class="text-lg font-semibold text-zsd-ash">{item.question}</h3>
              <p class="mt-3 text-sm leading-6 text-zsd-muted">{item.answer}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="mt-12" aria-labelledby="related-title">
      <div class="mb-6">
        <p class="text-sm font-semibold text-zsd-orange">Related Pages</p>
        <h2 id="related-title" class="mt-2 text-2xl font-semibold text-zsd-ash">Continue planning</h2>
      </div>

      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {relatedPages.map((page) => <Card {...page} label="Open page" />)}
      </div>
    </section>
  </PageContainer>
</BaseLayout>
