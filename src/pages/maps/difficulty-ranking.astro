---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/Card.astro";
import PageContainer from "../../components/PageContainer.astro";
import mapsData from "../../data/maps.json";
import type { MapRankingRecord } from "../../types/map";

const rankings = mapsData as MapRankingRecord[];

const relatedPages = [
  {
    title: "Build 42 Map Guide",
    description: "Use the main map guide for Build 42 town planning before comparing difficulty.",
    href: "/guides/project-zomboid-map/",
  },
  {
    title: "Interactive Map",
    description: "Use the map hub as the starting point for routes, areas and future filters.",
    href: "/maps/interactive-map",
  },
  {
    title: "Best Base Locations",
    description: "Compare future base picks by safety, access and long-term survival value.",
    href: "/guides/best-base-locations/",
  },
  {
    title: "Rosewood Guide",
    description: "Open the Rosewood location page for base and route planning.",
    href: "/locations/rosewood/",
  },
  {
    title: "Louisville Guide",
    description: "Open the Louisville location page for high-risk city survival planning.",
    href: "/locations/louisville",
  },
];
---

<BaseLayout
  title="Project Zomboid Map Difficulty Ranking"
  description="Compare Project Zomboid map areas by difficulty, player fit and main survival challenge before choosing your next route."
>
  <PageContainer as="section" class="py-12 sm:py-16">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold text-zsd-orange">Map Difficulty Ranking</p>
      <h1 class="mt-3 text-4xl font-bold text-zsd-ash">Project Zomboid Map Difficulty Ranking</h1>
      <p class="mt-5 text-base leading-7 text-zsd-muted">
        Different Project Zomboid map areas suit different survival styles. Some locations are easier
        for learning core systems, while larger cities demand tighter route planning, better noise
        control and faster escape decisions.
      </p>
    </div>

    <section class="mt-12" aria-labelledby="ranking-title">
      <div class="mb-6 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="text-sm font-semibold text-zsd-orange">Difficulty Ranking</p>
          <h2 id="ranking-title" class="mt-2 text-2xl font-semibold text-zsd-ash">First map comparison set</h2>
        </div>
        <p class="max-w-xl text-sm leading-6 text-zsd-muted">
          MVP v0.1 starts with two core areas. More towns can be added later through the same card
          structure.
        </p>
      </div>

      <div class="grid gap-4 lg:grid-cols-2">
        {
          rankings.map((location) => (
            <Card
              title={location.name}
              description={`Challenge: ${location.challenge}`}
              href={location.guideLink}
              label="View Guide"
              eyebrow="Location Name"
              badge={location.tier}
              stats={[
                { label: "Tier", value: location.tier },
                { label: "Difficulty", value: location.difficulty },
                { label: "Recommended Player", value: location.recommendedFor },
              ]}
            />
          ))
        }
      </div>
    </section>

    <section class="mt-12" aria-labelledby="related-title">
      <div class="mb-6">
        <p class="text-sm font-semibold text-zsd-orange">Related Pages</p>
        <h2 id="related-title" class="mt-2 text-2xl font-semibold text-zsd-ash">Continue planning</h2>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        {relatedPages.map((page) => <Card {...page} label="Open page" />)}
      </div>
    </section>
  </PageContainer>
</BaseLayout>
