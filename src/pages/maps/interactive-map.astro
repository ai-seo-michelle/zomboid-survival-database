---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/Card.astro";
import PageContainer from "../../components/PageContainer.astro";

const popularAreas = [
  {
    title: "Rosewood",
    description: "A compact starter area for learning routes, bases and early supply planning.",
    href: "/locations/rosewood",
  },
  {
    title: "Louisville",
    description: "A dense urban area for experienced players planning higher-risk survival routes.",
    href: "/locations/louisville",
  },
];

const futureTools = [
  {
    title: "Location Search",
    description: "Searchable location records for towns, points of interest and survival notes.",
  },
  {
    title: "Base Finder",
    description: "A future tool for comparing base candidates by safety, access and long-term value.",
  },
  {
    title: "Loot Database",
    description: "Structured loot categories for planning routes before committing to a run.",
  },
];

const relatedMapGuides = [
  {
    title: "Build 42 Map Guide",
    description:
      "Use the main Project Zomboid Build 42 map guide for town comparison and route planning while the full interactive toolset is still future-facing.",
    href: "/guides/project-zomboid-map/",
  },
  {
    title: "Map Difficulty Ranking",
    description: "Compare map areas by difficulty, player fit and survival challenge.",
    href: "/maps/difficulty-ranking/",
  },
];
---

<BaseLayout
  title="Project Zomboid Interactive Map"
  description="Use the Project Zomboid Interactive Map hub to find map areas, plan survival routes and prepare for future location tools."
>
  <PageContainer as="section" class="py-12 sm:py-16">
    <div class="grid gap-8 lg:grid-cols-[1fr_360px] lg:items-start">
      <div>
        <p class="text-sm font-semibold text-zsd-orange">Interactive Map</p>
        <h1 class="mt-3 text-4xl font-bold text-zsd-ash">Project Zomboid Interactive Map</h1>
        <p class="mt-5 max-w-3xl text-base leading-7 text-zsd-muted">
          This page is the map entry hub for Zomboid Survival Database. The current MVP focuses on
          map area links and survival planning context while the full interactive toolset is prepared.
        </p>

        <div class="mt-8 min-h-[360px] border border-zsd-line bg-zsd-panel/70 p-6">
          <div class="grid h-full min-h-[312px] gap-4 border border-dashed border-zsd-green/50 bg-zsd-black/45 p-5 md:grid-cols-[1fr_220px]">
            <div class="flex items-center">
              <div class="max-w-xl">
                <p class="text-sm font-semibold text-zsd-green-soft">Map interface reserved</p>
                <h2 class="mt-3 text-2xl font-semibold text-zsd-ash">Future interactive map module</h2>
                <p class="mt-3 text-sm leading-6 text-zsd-muted">
                  This area is ready for location pins, filters, route notes and database-powered map
                  search without changing the current site architecture.
                </p>
              </div>
            </div>
            <div class="grid content-center gap-3 text-sm">
              <div class="border border-zsd-line bg-zsd-panel/80 p-3 text-zsd-muted">Grid reference</div>
              <div class="border border-zsd-line bg-zsd-panel/80 p-3 text-zsd-muted">Location pins</div>
              <div class="border border-zsd-line bg-zsd-panel/80 p-3 text-zsd-muted">Route layers</div>
            </div>
          </div>
        </div>
      </div>

      <aside class="border border-zsd-line bg-zsd-panel/80 p-5">
        <p class="text-sm font-semibold text-zsd-orange">Map Use Cases</p>
        <h2 class="mt-2 text-lg font-semibold text-zsd-ash">How players use maps</h2>
        <ul class="mt-4 space-y-3 text-sm leading-6 text-zsd-muted">
          <li>Choose a spawn area before starting a new character.</li>
          <li>Plan routes between safe houses, loot spots and vehicle access points.</li>
          <li>Compare risk before entering dense urban zones.</li>
        </ul>
      </aside>
    </div>

    <section class="mt-12" aria-labelledby="about-map-title">
      <div class="grid gap-6 md:grid-cols-2">
        <article class="border border-zsd-line bg-zsd-panel/80 p-5">
          <p class="text-sm font-semibold text-zsd-orange">What is it?</p>
          <h2 id="about-map-title" class="mt-2 text-2xl font-semibold text-zsd-ash">
            What is Project Zomboid Interactive Map?
          </h2>
          <p class="mt-4 text-sm leading-6 text-zsd-muted">
            A Project Zomboid interactive map helps players connect locations with survival decisions:
            where to travel, what to avoid and which areas deserve deeper planning.
          </p>
        </article>

        <article class="border border-zsd-line bg-zsd-panel/80 p-5">
          <p class="text-sm font-semibold text-zsd-orange">Planning</p>
          <h2 class="mt-2 text-2xl font-semibold text-zsd-ash">How players use maps</h2>
          <p class="mt-4 text-sm leading-6 text-zsd-muted">
            Map planning is useful before a run and during long-term survival. Players use map pages to
            judge travel distance, likely danger, base access and nearby resources.
          </p>
        </article>
      </div>
    </section>

    <section class="mt-12" aria-labelledby="popular-map-areas">
      <div class="mb-6">
        <p class="text-sm font-semibold text-zsd-orange">Popular Map Areas</p>
        <h2 id="popular-map-areas" class="mt-2 text-2xl font-semibold text-zsd-ash">Start with key locations</h2>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        {popularAreas.map((area) => <Card {...area} label="Open location" />)}
      </div>
    </section>

    <section class="mt-12" aria-labelledby="future-tools-title">
      <div class="mb-6">
        <p class="text-sm font-semibold text-zsd-orange">Future Tools</p>
        <h2 id="future-tools-title" class="mt-2 text-2xl font-semibold text-zsd-ash">Built to expand later</h2>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        {futureTools.map((tool) => <Card {...tool} />)}
      </div>
    </section>

    <section class="mt-12" aria-labelledby="related-map-guides-title">
      <div class="mb-6">
        <p class="text-sm font-semibold text-zsd-orange">Related Map Guides</p>
        <h2 id="related-map-guides-title" class="mt-2 text-2xl font-semibold text-zsd-ash">
          Continue map planning
        </h2>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        {relatedMapGuides.map((guide) => <Card {...guide} label="Open guide" />)}
      </div>
    </section>
  </PageContainer>
</BaseLayout>
