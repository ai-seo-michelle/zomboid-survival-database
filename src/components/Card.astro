---
export interface Props {
  title: string;
  description?: string;
  href?: string;
  label?: string;
  eyebrow?: string;
  badge?: string;
  stats?: {
    label: string;
    value: string | number;
  }[];
}

const {
  title,
  description,
  href,
  label = "Open",
  eyebrow = "Database Entry",
  badge,
  stats = [],
} = Astro.props;
const Tag = href ? "a" : "article";
const attrs = href ? { href } : {};
---

<Tag
  {...attrs}
  class="group block h-full border border-zsd-line bg-zsd-panel/80 p-5 transition hover:border-zsd-green hover:bg-zsd-panel"
>
  <div class="flex h-full flex-col gap-4">
    <div>
      <div class="mb-3 flex items-center justify-between gap-3">
        <p class="text-xs font-semibold uppercase text-zsd-orange">{eyebrow}</p>
        {badge && (
          <span class="border border-zsd-green bg-zsd-green/15 px-2 py-1 text-xs font-semibold text-zsd-green-soft">
            {badge}
          </span>
        )}
      </div>
      <h2 class="text-xl font-semibold text-zsd-ash">{title}</h2>
      {description && <p class="mt-3 text-sm leading-6 text-zsd-muted">{description}</p>}
      {
        stats.length > 0 && (
          <dl class="mt-5 grid gap-3 sm:grid-cols-2">
            {stats.map((stat) => (
              <div class="border border-zsd-line/80 bg-zsd-black/35 p-3">
                <dt class="text-xs font-semibold uppercase text-zsd-muted">{stat.label}</dt>
                <dd class="mt-1 text-sm font-semibold text-zsd-ash">{stat.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
    {href && (
      <span class="mt-auto inline-flex items-center text-sm font-semibold text-zsd-green-soft group-hover:text-zsd-orange">
        {label}
        <span aria-hidden="true" class="ml-2">-&gt;</span>
      </span>
    )}
  </div>
</Tag>
