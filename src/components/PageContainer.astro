---
export interface Props {
  as?: keyof HTMLElementTagNameMap;
  narrow?: boolean;
  class?: string;
}

const { as = "div", narrow = false, class: className = "" } = Astro.props;
const Tag = as;
---

<Tag
  class:list={[
    "mx-auto w-full px-4 sm:px-6 lg:px-8",
    narrow ? "max-w-4xl" : "max-w-6xl",
    className,
  ]}
>
  <slot />
</Tag>

